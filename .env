# Audi A4 - Diesel Efficiency  
# Fuel-efficient diesel cars perfect for long distances
# Updated: Fixed pagination to get ALL results (not just first 20)
BASE_URL=https://www.mobile.bg/obiavi
GENERAL_TYPE=avtomobili-dzhipove
BRAND=bmw
MODEL=series-3
#dzhip, kombi, sedan,kabrio, sedan etc
VEHICLE_TYPE=dzhip
#benzinov,dizelov,elektricheski,hibrid
FUEL_TYPE=benzinov
MIN_PRICE=7000
MAX_PRICE=22000
MIN_ENGINE_POWER=120
MAX_ENGINE_POWER=250

# Output configuration
TABLE_NAME=bmw_series_3
EXCEL_PATH=docs/series-3.xlsx
EXCEL_DIR=docs
EXCEL_FILE=bmw_series_3-complete.xlsx
SHEET_NAME=BMW-Series-3-Complete

# Crawler settings to get ALL pages
MAX_PAGES=20
DELAY=0.8